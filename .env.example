# Application
APP_ENV=development
PROJECT_NAME=PlaygroundAgent
DEBUG=true

# LLM — provider selection ("anthropic" | "openai" | "google")
LLM_PROVIDER=anthropic

# Anthropic / Claude (default provider)
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# OpenAI (optional — set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Google Gemini (optional — set LLM_PROVIDER=google to use)
# GOOGLE_API_KEY=AI...
# GOOGLE_MODEL=gemini-2.0-flash

DEFAULT_LLM_TEMPERATURE=0.7
MAX_TOKENS=2048

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=playground_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
